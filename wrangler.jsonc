// Cloudflare Workers static-assets deployment for the `next build` output.
// Deploy with: npm run build && npx wrangler deploy
{
  "name": "math-visualizer",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    // Serve out/404.html for unknown paths. `/about` -> about.html is handled
    // by the default html_handling ("auto-trailing-slash").
    "not_found_handling": "404-page",
  },
  // Worker Previews (one per branch, via `npx wrangler preview`) don't inherit
  // production vars or bindings. This Worker has none; `assets` and
  // `compatibility_date` are top-level only and apply to Previews too.
  "previews": {},
}
